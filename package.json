{
  "name": "wiztri",
  "version": "0.3.4",
  "private": true,
  "description": "Wiztri — disk usage analyzer desktop app (Electron)",
  "author": "Dito Bima Ramadhan",
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win",
    "test": "node test/smoke.js && node test/electron-smoke.js && node test/electron-cdp.js && node test/electron-scan.js && node test/ui-logic.spec.mjs && node test/serve.spec.mjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wiztri.app",
    "productName": "Wiztri",
    "directories": {
      "output": "installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "rust-scanner/target/x86_64-pc-windows-gnu/release/wiztri-scan.exe",
        "to": "wiztri-scan.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "wiztri setup.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
